# ─────────────────────────────────────────────────────────────
# Atlas Docker environment
# Copy to .env:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Local dev (docker compose up) ───────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=atlas_db
POSTGRES_PORT=5432

REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=8080

JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# ── Production (docker compose -f docker-compose.yml -f docker-compose.prod.yml) ──
# Point your domain's A record to the VPS IP, then set:
DOMAIN=atlas.yourdomain.com
ACME_EMAIL=you@yourdomain.com
CORS_ORIGINS=https://atlas.yourdomain.com
